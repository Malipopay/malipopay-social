FROM node:22.20-bookworm-slim
ARG NEXT_PUBLIC_VERSION
ENV NEXT_PUBLIC_VERSION=$NEXT_PUBLIC_VERSION
RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ \
    make \
    python3-pip \
    bash \
    nginx \
&& rm -rf /var/lib/apt/lists/*

RUN addgroup --system www \
 && adduser --system --ingroup www --home /www --shell /usr/sbin/nologin www \
 && mkdir -p /www \
 && chown -R www:www /www /var/lib/nginx


RUN npm --no-update-notifier --no-fund --global install pnpm@10.6.1 pm2

WORKDIR /app

COPY . /app
COPY var/docker/nginx.conf /etc/nginx/nginx.conf

# --frozen-lockfile pins the build to the committed pnpm-lock.yaml.
# Without it every image build re-resolved dependencies, so the same commit
# produced different trees on different days: the 2026-11-12 build failed with
# "Can't resolve '@vercel/turbopack-next/internal/font/google/font'" on code
# that had built cleanly ten days earlier. Deploys must be reproducible.
RUN pnpm install --frozen-lockfile
RUN NODE_OPTIONS="--max-old-space-size=4096" pnpm run build

# wait-for-temporal gates PM2 so the orchestrator never builds its Temporal
# workers before Temporal can serve. See the file for why this cannot be
# left to docker-compose depends_on.
CMD ["sh", "-c", "nginx && node var/docker/wait-for-temporal.js && pnpm run pm2"]
